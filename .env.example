# Database
DB_URL=sqlite:///./data/dev.db
DATA_DIR=./data

# Access control
MODE=read-only
LIMIT_DEFAULT=100
TIMEOUT_MS=5000
ALLOW_DESTRUCTIVE=false

# Admin UI
ENABLE_UI=true
ENABLE_EXPLANATIONS=true
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8123,http://127.0.0.1:8123

# MCP rate limits (0 disables; pytest sets these off automatically)
MCP_RATE_LIMIT=60
SSE_MAX_PER_IP=10

# LLM (admin chat assistant)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_BASE_URL=
LLM_TIMEOUT_MS=60000

# Optional Fernet key for encrypting API keys in settings.db (32 url-safe base64 bytes)
SECRET_KEY=
